# Default configuration for the Medical RAG Agent.
#
# This file is committed and holds DEFAULTS ONLY - never put a real secret
# here. Anything set as a real environment variable (docker-compose
# `environment:`, `export VAR=...`, a platform secret store) takes
# precedence over every value below, because app/config/properties_setup.py
# calls load_dotenv(), which does not overwrite existing env vars.
#
# So: tune the knobs here, inject secrets from the outside.

# App
APP_NAME=Medical AI
APP_VERSION=0.1.0
APP_PORT=8000
DEBUG=true
API_PREFIX=/api/v1

#Embedding
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# LLM - the key is intentionally blank; supply it from the environment as
# OPENROUTER_API_KEY (docker-compose passes it through to the container).
# The legacy dotted names (open_router.api_key / .url / .model) are still
# read as a fallback if you prefer them in this file.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b

# Qdrant - works with either deployment:
#   self-hosted : http://localhost:6333 (bare metal) or http://qdrant:6333
#                 (docker-compose, injected by the app service), no API key
#   managed     : https://<cluster-id>.<region>.cloud.qdrant.io:6333 plus
#                 QDRANT_API_KEY, both injected from the environment
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag-documents

# Ingestion - source PDF auto-ingested (once, idempotent) on app startup
MEDICAL_PDF_PATH=docs/Medical_Book.pdf

# RAG Agent
RAG_TOP_K=4
RAG_RECENT_TURNS=4
RAG_TEMPERATURE=0.3
RAG_MAX_TOKENS=1024
RAG_REASONING_MAX_TOKENS=300

# Evaluator Agent
EVALUATOR_TEMPERATURE=0.0
EVALUATOR_MAX_TOKENS=1024
EVALUATOR_REASONING_MAX_TOKENS=100
CONFIDENCE_THRESHOLD=0.6
TONE_THRESHOLD=0.6
MAX_RETRIES=2

# Reviser Agent
REVISER_TEMPERATURE=0.3
REVISER_MAX_TOKENS=1024
REVISER_REASONING_MAX_TOKENS=300

# Summarizer Agent
SUMMARIZER_TEMPERATURE=0.3
SUMMARIZER_MAX_TOKENS=600
SUMMARIZER_REASONING_MAX_TOKENS=200

# Planner Agent
PLANNER_TEMPERATURE=0.0
PLANNER_MAX_TOKENS=500
PLANNER_REASONING_MAX_TOKENS=100
