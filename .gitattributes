# Normalize line endings for text, but NEVER touch binary files.
# Without this, a machine with core.autocrlf=true can CRLF-mangle the bytes
# inside docs/Medical_Book.pdf on `git add`, corrupting its compressed
# streams so pdfminer reads 0 pages. (That is exactly what happened once.)
* text=auto

*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.parquet binary
*.bin   binary
*.pt    binary
*.onnx  binary

# Keep shell scripts LF regardless of platform.
*.sh    text eol=lf
